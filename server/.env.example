# NEXA Main server — environment template. NAMES ONLY. Never put real secrets here.
NODE_ENV=development
PORT=8787
PUBLIC_URL=
NEXA_PUBLIC_URL=
CORS_ORIGINS=
# Number of trusted proxy hops, or a comma-separated CIDR list. Default 1.
TRUST_PROXY=1
# Request timeout and rate limiting (RateLimit headers are sent on every response)
REQUEST_TIMEOUT_MS=30000
DB_PATH=
# Backup and restore
BACKUP_DIR=
BACKUP_MAX_AGE_HOURS=26
# Fees and wallet
NEXA_FEES_WAIVED=
NEXA_WALLET_MODE=
# Payments
PAYMENTS_ENABLED=
PAYMENT_MODE=
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=
PAYMENT_RECONCILE_DISABLED=
# Admin identity
NEXA_ADMIN_EMAILS=
NEXA_ADMIN_USER_IDS=
# Auth email
AUTH_EMAIL_MODE=
AUTH_EMAIL_WEBHOOK_URL=
AUTH_EMAIL_WEBHOOK_TOKEN=
# AI providers
NEXA_AI_PROVIDER=
DAMI_AI_PROVIDER=
XAI_API_KEY=
# Optional Grok overrides (defaults shown):
# XAI_MODEL=grok-4.7
# XAI_IMAGE_MODEL=grok-imagine-image-2.0
# XAI_STT_MODEL=grok-voice-transcribe-2.0
# XAI_TTS_FEMALE_VOICE=ara
# XAI_TTS_MALE_VOICE=rex
# Market data
MARKET_DATA_MODE=
MARKET_DATA_TOKEN=
# Push and calls
NEXA_PUSH_DELIVERY_ENABLED=
NEXA_TURN_URL=
NEXA_TURN_USERNAME=
NEXA_TURN_CREDENTIAL=
# Monitoring
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=
